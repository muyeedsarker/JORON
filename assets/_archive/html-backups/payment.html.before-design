<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JORON — Membership Payment</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

body{
  font-family:Arial,"Noto Sans Bengali",sans-serif;
  background:linear-gradient(135deg,#e8f7f2,#f7faf9);
  min-height:100vh;
  padding:25px 15px;
  color:#222
}

.payment-box{
  max-width:560px;
  margin:auto;
  background:#fff;
  padding:30px 22px;
  border-radius:24px;
  box-shadow:0 10px 35px rgba(0,0,0,.10)
}

.logo{
  text-align:center;
  color:#126b5b;
  font-size:34px;
  font-weight:800
}

.tagline{
  text-align:center;
  color:#777;
  margin:7px 0 25px
}

h1{
  text-align:center;
  font-size:24px;
  margin-bottom:20px
}

.plan{
  padding:20px;
  border-radius:18px;
  background:linear-gradient(135deg,#fff7d6,#f6edff,#eaf8ff);
  border:2px solid #d8b85c;
  text-align:center;
  box-shadow:0 8px 25px rgba(190,145,35,.18)
}

.plan-name{
  color:#8d6800;
  font-size:21px;
  font-weight:bold
}

.price{
  font-size:32px;
  font-weight:800;
  margin-top:7px
}

.section{
  margin-top:22px;
  padding:18px;
  background:#f7fbf9;
  border-radius:15px;
  border:1px solid #dcefe9
}

.section h2{
  color:#126b5b;
  font-size:18px;
  margin-bottom:12px
}

.payment-method{
  padding:15px;
  background:white;
  border-radius:12px;
  border:1px solid #ddd;
  margin-top:10px
}

.payment-method strong{
  color:#126b5b
}

label{
  display:block;
  margin:14px 0 7px;
  font-weight:bold
}

input{
  width:100%;
  padding:13px;
  border:1px solid #ddd;
  border-radius:10px;
  font-size:16px;
  outline:none
}

input:focus{
  border-color:#126b5b
}

button{
  width:100%;
  margin-top:22px;
  padding:15px;
  border:0;
  border-radius:28px;
  background:linear-gradient(135deg,#126b5b,#16856f);
  color:#fff;
  font-size:17px;
  font-weight:bold;
  cursor:pointer
}

button:disabled{
  opacity:.6
}

.note{
  margin-top:18px;
  padding:14px;
  background:#eef9f5;
  border-radius:12px;
  color:#52605c;
  font-size:13px;
  line-height:1.6;
  text-align:center
}

.back{
  display:block;
  text-align:center;
  margin-top:20px;
  color:#126b5b;
  text-decoration:none;
  font-weight:bold
}
</style>
</head>

<body>

<div class="payment-box">

  <div class="logo">JORON</div>

  <div class="tagline">
    দুজনের গল্প, এক জোড়ন। ❤️
  </div>

  <h1>💳 Membership Payment</h1>

  <div class="plan">
    <div class="plan-name" id="planName">
      Membership
    </div>

    <div class="price" id="planPrice">
      ৳0
    </div>
  </div>

  <div class="section">

    <h2>💰 Payment Method</h2>

    <div class="payment-method">
      <strong>bKash</strong><br>
      Payment নম্বর: <span id="paymentNumber">01XXXXXXXXX</span>
    </div>

    <div class="payment-method">
      <strong>Nagad</strong><br>
      Payment নম্বর: <span id="nagadNumber">01XXXXXXXXX</span>
    </div>

    <p style="margin-top:12px;font-size:13px;color:#777;line-height:1.6">
      ⚠️ এখানে আপনার আসল bKash/Nagad নম্বর বসাতে হবে।
      টাকা পাঠানোর পর Transaction ID নিচে লিখুন।
    </p>

  </div>

  <form id="paymentForm">

    <label for="senderNumber">
      যে নম্বর থেকে টাকা পাঠিয়েছেন
    </label>

    <input
      type="tel"
      id="senderNumber"
      placeholder="01XXXXXXXXX"
      pattern="01[0-9]{9}"
      required
    >

    <label for="transactionId">
      Transaction ID
    </label>

    <input
      type="text"
      id="transactionId"
      placeholder="যেমন: 8A7B6C5D"
      required
    >

    <button type="submit" id="submitButton">
      Payment Verification-এর জন্য পাঠান
    </button>

  </form>

  <div class="note">
    🔒 Payment submit করার পর Admin যাচাই করবেন।
    যাচাই সম্পন্ন হলে আপনার Membership Active হবে।
  </div>

  <a href="index.html" class="back">
    ← JORON হোমে ফিরে যান
  </a>

</div>


<script type="module">

import {
  initializeApp
} from "https://www.gstatic.com/firebasejs/12.16.0/firebase-app.js";

import {
  getAuth,
  onAuthStateChanged
} from "https://www.gstatic.com/firebasejs/12.16.0/firebase-auth.js";

import {
  getFirestore,
  doc,
  getDoc,
  setDoc,
  serverTimestamp
} from "https://www.gstatic.com/firebasejs/12.16.0/firebase-firestore.js";


const firebaseConfig = {

  apiKey:
    "AIzaSyDWxxu3zwThJp1fuWMhXiRig3Fswt0QARA",

  authDomain:
    "joron-d7742.firebaseapp.com",

  projectId:
    "joron-d7742",

  storageBucket:
    "joron-d7742.firebasestorage.app",

  messagingSenderId:
    "907727989078",

  appId:
    "1:907727989078:web:4fdd266e3517a862fa0ef7",

  measurementId:
    "G-Q8PXH6C5NC"
};


const app = initializeApp(firebaseConfig);

const auth = getAuth(app);

const db = getFirestore(app);


const planName =
  document.getElementById("planName");

const planPrice =
  document.getElementById("planPrice");

const paymentForm =
  document.getElementById("paymentForm");

const submitButton =
  document.getElementById("submitButton");


let currentUser = null;


onAuthStateChanged(
  auth,
  async function(user){

    if(!user){

      alert(
        "Payment করতে আগে Login করুন।"
      );

      window.location.href =
        "login.html";

      return;
    }

    currentUser = user;


    try{

      const userRef =
        doc(
          db,
          "users",
          user.uid
        );

      const userSnap =
        await getDoc(userRef);


      if(userSnap.exists()){

        const data =
          userSnap.data();


        planName.textContent =
          data.membership ||
          "Membership";


        planPrice.textContent =
          "৳" +
          (
            data.membershipPrice ||
            0
          );

      }

    }catch(error){

      console.error(error);

    }

  }
);


paymentForm.addEventListener(
  "submit",
  async function(event){

    event.preventDefault();


    if(!currentUser){

      alert(
        "আপনি Login করা নেই।"
      );

      return;
    }


    const senderNumber =
      document
        .getElementById("senderNumber")
        .value
        .trim();


    const transactionId =
      document
        .getElementById("transactionId")
        .value
        .trim();


    const phonePattern =
      /^01[0-9]{9}$/;


    if(
      !phonePattern.test(
        senderNumber
      )
    ){

      alert(
        "সঠিক বাংলাদেশি মোবাইল নম্বর দিন।"
      );

      return;
    }


    if(!transactionId){

      alert(
        "Transaction ID লিখুন।"
      );

      return;
    }


    submitButton.disabled =
      true;

    submitButton.textContent =
      "Payment জমা হচ্ছে...";


    try{

      await setDoc(

        doc(
          db,
          "payments",
          currentUser.uid
        ),

        {

          uid:
            currentUser.uid,

          email:
            currentUser.email || "",

          senderNumber:
            senderNumber,

          transactionId:
            transactionId,

          paymentStatus:
            "pending",

          membershipStatus:
            "pending",

          submittedAt:
            serverTimestamp(),

          updatedAt:
            serverTimestamp()

        },

        {
          merge:true
        }

      );


      await setDoc(

        doc(
          db,
          "users",
          currentUser.uid
        ),

        {

          paymentStatus:
            "pending",

          membershipStatus:
            "pending",

          updatedAt:
            serverTimestamp()

        },

        {
          merge:true
        }

      );


      alert(
        "Payment তথ্য সফলভাবে জমা হয়েছে। Admin যাচাই করার পর Membership Active হবে।"
      );


      window.location.href =
        "profile.html?id=" +
        encodeURIComponent(
          currentUser.uid
        );


    }catch(error){

      console.error(error);

      alert(
        "Payment তথ্য জমা দেওয়া যায়নি। আবার চেষ্টা করুন।\n\n" +
        error.message
      );


      submitButton.disabled =
        false;

      submitButton.textContent =
        "Payment Verification-এর জন্য পাঠান";

    }

  }
);

</script>

</body>
</html>
